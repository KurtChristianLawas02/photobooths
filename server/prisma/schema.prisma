generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String     @id @default(cuid())
  name        String
  date        DateTime?
  location    String?
  description String?
  isActive    Boolean    @default(true)
  templates   Template[]
  sessions    PhotoSession[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Template {
  id              String        @id @default(cuid())
  name            String
  description     String?
  physicalWidth   Float
  physicalHeight  Float
  widthPixels     Int
  heightPixels    Int
  dpi             Int           @default(300)
  orientation     String
  aspectRatio     String
  printSize       String        @default("4x6")
  thumbnail       String?
  thumbnailUrl    String?
  requiredPhotos  Int           @default(1)
  background      String        @default("#ffffff")
  configuration   Json
  active          Boolean       @default(true)
  eventId         String?
  event           Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  elements        TemplateElement[]
  sessions        PhotoSession[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model TemplateElement {
  id         String   @id @default(cuid())
  templateId String
  type       String
  config     Json
  sortOrder  Int      @default(0)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model PhotoSession {
  id         String   @id @default(cuid())
  eventId    String?
  templateId String?
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  photos     Photo[]
  createdAt  DateTime @default(now())
}

model Photo {
  id        String       @id @default(cuid())
  sessionId String?
  session   PhotoSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  fileUrl   String
  qrToken   String       @unique
  createdAt DateTime     @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
